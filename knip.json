{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["api/**/*.js"],
      "ignore": ["scripts/preinstall.js"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "index.html"],
      "project": ["src/**/*.{ts,tsx}"],
      "paths": {
        "@/*": ["src/*"]
      },
      "ignore": [
        "src/components/ui/**",
        "src/__tests__/**",
        "src/components/dashboard/DashboardCalendar.tsx",
        "src/components/dashboard/DashboardPersonalisationPanel.tsx",
        "src/components/dashboard/widgets/InsightsWidget.tsx",
        "src/components/dashboard/widgets/JobFeedWidget.tsx",
        "src/components/dashboard/widgets/MindsetStreakWidget.tsx",
        "src/components/dashboard/widgets/ProgressObjectivesWidget.tsx",
        "src/components/diary/DiaryPreviewWidget.tsx",
        "src/components/search/SearchChatComposer.tsx",
        "src/features/home/TrendingSectorCard.tsx"
      ],
      "ignoreDependencies": [
        "next-themes"
      ]
    },
    "apps/server": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": [
        "src/vendor.d.ts"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "scripts": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": [
    "**/dist/**",
    "**/node_modules/**",
    "**/build/**",
    "**/.turbo/**",
    "e2e/**",
    "docs/eval-wendy/**"
  ],
  "ignoreDependencies": [
    "@opentelemetry/auto-instrumentations-node",
    "@opentelemetry/resources",
    "@opentelemetry/sdk-logs",
    "@opentelemetry/semantic-conventions",
    "@opentelemetry/instrumentation-http",
    "react-speech-recognition",
    "stripe",
    "bcryptjs",
    "@workspace/design-tokens",
    "drizzle-orm",
    "@workspace/db",
    "@esbuild/win32-x64",
    "@rollup/rollup-win32-x64-msvc",
    "prettier",
    "esbuild",
    "@clerk/types",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-avatar",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-context-menu",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-progress",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-slider",
    "@tailwindcss/typography",
    "@testing-library/user-event",
    "@types/react-speech-recognition",
    "embla-carousel-react",
    "input-otp",
    "react-day-picker",
    "react-icons",
    "react-resizable-panels",
    "tailwindcss",
    "tw-animate-css",
    "vaul",
    "@types/bcryptjs"
  ],
  "ignoreBinaries": [
    "docker",
    "concurrently",
    "serve",
    "wait-on",
    "vite-bundle-visualizer"
  ],
  "ignoreIssues": {
    "**/*.{ts,tsx}": ["exports", "types", "duplicates"],
    "pnpm-workspace.yaml": ["catalog"]
  }
}
