{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "kill-port",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/kill-port.mjs"
			],
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "dev:web",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"dev:web"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"isBackground": true,
			"dependsOn": [
				"kill-port"
			],
			"problemMatcher": {
				"pattern": {
					"regexp": "^(.*)$",
					"file": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:.*http://localhost:5173"
				}
			}
		},
		{
			"label": "dev:orientamento",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"dev:orientamento"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"isBackground": true,
			"dependsOn": [
				"kill-port"
			],
			"problemMatcher": {
				"pattern": {
					"regexp": "^(.*)$",
					"file": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:.*http://localhost:5173"
				}
			}
		},
		{
			"label": "dev:server",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"dev:server"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "install",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"install"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "build",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"build"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "start:all",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"dev:all"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}