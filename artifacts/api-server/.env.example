# ─── NorthStar API Server — Environment Variables ────────────────────────────
# Copia questo file in .env e compila i valori.
# NON committare mai il file .env nel repository.
#
# Formato: NOME=valore  (senza spazi attorno a =)
# Stringhe con spazi: NOME="valore con spazi"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/northstar

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-questa-stringa-con-almeno-32-caratteri-casuali
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=chiave-admin-segreta

# ─── Wendy AI — LLM Providers ─────────────────────────────────────────────────
# Almeno uno dei tre provider deve essere configurato.
# Il router usa la priorità: OPENAI → ANTHROPIC → GOOGLE
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=

# ─── Wendy AI — Router config ─────────────────────────────────────────────────
# Override provider per use case (opzionale — il router sceglie in automatico)
# Valori validi: openai | anthropic | google
AI_CHAT_PROVIDER=openai
AI_VISION_PROVIDER=openai
AI_IMAGE_GENERATION_PROVIDER=openai

# Override modello specifico (opzionale)
# AI_CHAT_MODEL=gpt-4.1
# AI_VISION_MODEL=gpt-4o
# AI_IMAGE_MODEL=dall-e-3

# ─── Wendy 2.0 — Voce (TTS + STT) ────────────────────────────────────────────
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID voce ElevenLabs (default: Sarah = EXAVITQu4vr4xnSDxMaL)
# Trova altri ID su: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Deepgram: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copia queste variabili nel file .env del frontend (artifacts/orientamento/.env)
# VITE_API_URL=http://localhost:3001/api
# VITE_WENDY_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
