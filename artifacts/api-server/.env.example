# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/northstar

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-questo-valore-in-produzione

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5000

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Piani Stripe (price ID)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── App URL ────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://northstar.app

# ── Sentry (Fase 2 — Monitoring) ───────────────────────────────────────────────
# Lascia vuoto per disabilitare Sentry in locale/test.
# In staging/prod: imposta il DSN dal tuo progetto Sentry.
SENTRY_DSN=
# Viene settato automaticamente dal CI (es. git SHA breve)
# SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# HEALTH_CHECK_TIMEOUT_MS=2000
