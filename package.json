{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "// ── DEV ─────────────────────────────────────────": "---",
    "dev": "pnpm run dev:all",
    "dev:server": "pnpm --filter @northstar/server run dev",
    "dev:web": "pnpm --filter @northstar/web run dev",
    "dev:orientamento": "pnpm --filter @northstar/web run dev",
    "dev:all": "concurrently -n docker,server,web --kill-others-on-fail \"docker compose up -d postgres redis || echo Docker not available, using local services\" \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "// ── BUILD ─────────────────────────────────────────": "---",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:server": "pnpm --filter @northstar/server run build",
    "start:server": "pnpm --filter @northstar/server run start",
    "// ── TYPE ─────────────────────────────────────────": "---",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "// ── LINT ─────────────────────────────────────────": "---",
    "lint": "pnpm run lint:server",
    "lint:server": "pnpm --filter @northstar/server run lint",
    "lint:all": "pnpm -r --if-present run lint",
    "// ── DB ──────────────────────────────────────────": "---",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db exec tsx migrate.ts",
    "db:push": "pnpm --filter @workspace/db run push",
    "// ── SECRETS ─────────────────────────────────────": "---",
    "secrets": "bash scripts/generate-secrets.sh",
    "secrets:env": "bash scripts/generate-secrets.sh --env",
    "// ── TEST ─────────────────────────────────────────": "---",
    "test": "pnpm run test:ai",
    "test:ai": "pnpm --filter @workspace/ai-server run test",
    "test:ai:watch": "pnpm --filter @workspace/ai-server run test:watch",
    "test:all": "pnpm -r --if-present run test",
    "test:e2e": "playwright test e2e/api.spec.ts",
    "test:e2e:browser": "playwright test e2e/auth.spec.ts e2e/test-riasec.spec.ts e2e/admin.spec.ts e2e/objectives.spec.ts",
    "test:e2e:api": "playwright test e2e/api.spec.ts e2e/api-wendy.spec.ts e2e/api-affiliate.spec.ts",
    "test:e2e:all": "playwright test",
    "// ── QA ──────────────────────────────────────────": "---",
    "qa": "pnpm run typecheck && pnpm run lint && pnpm run test:ai",
    "check": "pnpm run typecheck && pnpm run lint:all && pnpm run test:all",
    "// ── CLI/MCP ─────────────────────────────────────": "---",
    "northstar": ".tools/printed-clis/northstar/bin/northstar-pp-cli.exe",
    "northstar:mcp": ".tools/printed-clis/northstar/bin/northstar-pp-mcp.exe",
    "northstar:regen": "cli-printing-press/printing-press.exe generate --spec packages/api-spec/openapi.yaml --name northstar --output .tools/printed-clis/northstar --force",
    "// ── CLEAN ────────────────────────────────────────": "---",
    "clean": "find . -name dist -not -path '*/node_modules/*' -exec rm -rf {} + ; find . -name .turbo -exec rm -rf {} +"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@playwright/test": "^1.59.1",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "opossum": "^9.0.0",
    "pg": "^8.20.0"
  }
}
