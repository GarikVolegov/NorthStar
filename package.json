{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "// ── DEV ─────────────────────────────────────────": "---",
    "dev": "pnpm run dev:all",
    "dev:server": "pnpm --filter @northstar/server run dev",
    "dev:web": "pnpm --filter @northstar/web run dev",
    "dev:orientamento": "pnpm --filter @northstar/web run dev",
    "dev:all": "concurrently -n docker,server,web --kill-others-on-fail \"docker compose up -d postgres redis || echo Docker not available, using local services\" \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:e2e": "node scripts/start-e2e-stack.mjs",
    "// ── BUILD ─────────────────────────────────────────": "---",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:analyze": "pnpm --filter @northstar/web exec vite build --config vite.config.ts --mode analyze && npx vite-bundle-visualizer",
    "build:server": "pnpm --filter @northstar/server run build",
    "start:server": "pnpm --filter @northstar/server run start",
    "// ── TYPE ─────────────────────────────────────────": "---",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @northstar/server run typecheck && pnpm --filter @northstar/web run typecheck && pnpm --filter @workspace/scripts run typecheck",
    "// ── LINT ─────────────────────────────────────────": "---",
    "lint": "eslint apps/server/src apps/web/src packages/ai-server/src e2e --max-warnings=0",
    "lint:ci": "pnpm run lint",
    "lint:legacy": "pnpm run lint",
    "lint:server": "pnpm --filter @northstar/server run lint",
    "lint:all": "pnpm -r --if-present run lint",
    "// ── DB ──────────────────────────────────────────": "---",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db exec tsx migrate.ts",
    "db:migrate:dry-run": "pnpm --filter @workspace/db run migrate:dry-run",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed:scenes": "node packages/db/seed-scene-cards.mjs",
    "// ── SECRETS ─────────────────────────────────────": "---",
    "secrets": "bash scripts/generate-secrets.sh",
    "secrets:env": "bash scripts/generate-secrets.sh --env",
    "admin:promote": "pnpm --filter @workspace/scripts run admin:promote --",
    "// ── TEST ─────────────────────────────────────────": "---",
    "test": "pnpm run test:ai",
    "test:ai": "pnpm --filter @workspace/ai-server run test",
    "test:ai:coverage": "pnpm --filter @workspace/ai-server run test:coverage",
    "test:ai:watch": "pnpm --filter @workspace/ai-server run test:watch",
    "test:server": "pnpm --filter @northstar/server run test",
    "test:server:coverage": "pnpm --filter @northstar/server run test:coverage",
    "test:web:coverage": "pnpm --filter @northstar/web run test:coverage",
    "test:all": "pnpm -r --if-present run test",
    "test:e2e": "playwright test e2e/api.spec.ts",
    "test:e2e:browser": "playwright test e2e/auth.spec.ts e2e/test-riasec.spec.ts e2e/admin.spec.ts e2e/objectives.spec.ts",
    "test:e2e:api": "playwright test e2e/api.spec.ts e2e/api-wendy.spec.ts e2e/api-affiliate.spec.ts",
    "test:smoke:core": "playwright test e2e/core-smoke.spec.ts",
    "test:e2e:all": "playwright test",
    "eval:wendy": "pnpm --filter @workspace/scripts run eval:wendy --mock",
    "// ── QA ──────────────────────────────────────────": "---",
    "quality:required": "pnpm run lint:ci && pnpm run typecheck && pnpm run test:ai:coverage && pnpm run test:server:coverage && pnpm run test:web:coverage && pnpm run audit:e2e-determinism && pnpm run audit:api-fetch && pnpm run audit:tech-debt && pnpm run audit:file-size && pnpm run audit:dead-code && pnpm run audit:feature-protocol && pnpm run audit:wendy-tools && pnpm run audit:db-types && pnpm run audit:mojibake",
    "quality:runtime": "pnpm run test:smoke:core && pnpm run test:e2e && pnpm run test:e2e:browser",
    "quality:full": "pnpm run quality:required && pnpm run build && pnpm run quality:runtime",
    "qa": "pnpm run quality:required",
    "check": "pnpm run lint:ci && pnpm run typecheck",
    "deploy:vercel:check": "node scripts/check-vercel-deploy.mjs",
    "// ── CLI/MCP ─────────────────────────────────────": "---",
    "northstar": ".brain/40_Agent_Context/tools/printed-clis/northstar/bin/northstar-pp-cli.exe",
    "northstar:mcp": ".brain/40_Agent_Context/tools/printed-clis/northstar/bin/northstar-pp-mcp.exe",
    "graphify:refresh": "tsx scripts/src/refresh-wikillm-graphs.ts",
    "// ── AUDIT ────────────────────────────────────────": "---",
    "audit:dead-code": "knip --reporter compact",
    "audit:dead-code:detail": "knip",
    "audit:file-size": "node scripts/check-file-size.mjs",
    "audit:feature-protocol": "tsx scripts/check-feature-protocol.ts",
    "audit:wendy-tools": "tsx scripts/check-wendy-tools.ts",
    "audit:api-fetch": "node scripts/check-api-fetch.mjs",
    "audit:api-contract": "node scripts/check-api-contract.mjs",
    "audit:tech-debt": "node scripts/check-tech-debt.mjs",
    "audit:db-types": "node scripts/check-db-types.mjs",
    "audit:mojibake": "node scripts/check-mojibake.mjs",
    "audit:e2e-determinism": "node scripts/check-playwright-e2e.mjs",
    "create:feature": "tsx scripts/create-feature.ts",
    "docs:api-routes": "tsx scripts/gen-api-docs.ts",
    "// ── CLEAN ────────────────────────────────────────": "---",
    "clean": "find . -name dist -not -path '*/node_modules/*' -exec rm -rf {} + ; find . -name .turbo -exec rm -rf {} +"
  },
  "private": true,
  "engines": {
    "node": ">=20.10.0 <25",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "knip": "^5.30.0",
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "opossum": "^9.0.0",
    "pg": "^8.20.0"
  }
}
