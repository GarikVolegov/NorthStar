modules = ["nodejs-20", "python-3.11", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["node", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "run", "build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/ai-agents: Python AI Service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "artifacts/ai-agents: Python AI Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/ai-agents && python3.11 -m uvicorn main:app --host 0.0.0.0 --port 8000 --no-access-log"
waitForPort = 8000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/orientamento run dev"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "python_openai_ai_integrations:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# ============================================================
# PORT MAPPING — solo le 3 porte necessarie
# ============================================================

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8099

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

# ============================================================
# SECRETS — NON aggiungere mai valori qui!
# Imposta tutte le variabili nel pannello Replit Secrets:
#
#   JWT_SECRET             → genera con: openssl rand -hex 64
#   ADMIN_KEY              → genera con: openssl rand -hex 32
#   STRIPE_PUBLISHABLE_KEY → da Stripe Dashboard
#   STRIPE_SECRET_KEY      → da Stripe Dashboard
#   STRIPE_WEBHOOK_SECRET  → da Stripe Dashboard (obbligatorio!)
#   RESEND_API_KEY         → da Resend Dashboard
#   TAVILY_API_KEY         → da Tavily Dashboard
#   DATABASE_URL           → da Neon/Supabase
#   AI_AGENTS_URL          → http://localhost:8000
# ============================================================

[userenv]
