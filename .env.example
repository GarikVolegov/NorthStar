# NorthStar — Variabili d'ambiente
# ─────────────────────────────────────────────────────────────────────────────
# Copia questo file: cp .env.example .env
# Non committare mai il file .env (è in .gitignore)
#
# REGOLA 0: per capire dove vengono usate queste variabili leggi:
#   → API_RULES.md   (server Express, auth, CORS)
#   → DB_RULES.md    (DATABASE_URL, migrations)
#   → AI_RULES.md    (OpenAI, costi, limiti)
#
# Genera JWT_SECRET e ADMIN_KEY con:
#   pnpm secrets        → stampa a video
#   pnpm secrets:env    → aggiunge direttamente a .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Server Express (apps/server) ──────────────────────────────────────────────
# Porta del nuovo server NorthStar
PORT=3001
# Ambiente: development | production
NODE_ENV=development
# Origini permesse dal CORS (virgola-separated, no spazi)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# URL base del frontend (usato per costruire referralUrl affiliato)
APP_URL=http://localhost:5173


# ── Database PostgreSQL ───────────────────────────────────────────────────────
# Dev locale (docker compose up postgres)
DATABASE_URL=postgresql://northstar:northstar_dev@localhost:5432/northstar
# Produzione: usa un connection string con SSL
# DATABASE_URL=postgresql://user:password@host:5432/northstar?sslmode=require


# ── JWT ──────────────────────────────────────────────────────────────────────
# Genera un secret con: pnpm secrets  (usa openssl rand -hex 48)
# NON usare un valore predefinito — il docker-compose fallirà se manca.
JWT_SECRET=${JWT_SECRET:?Genera con: pnpm secrets}
# Durata token (es. 7d, 24h, 30m)
JWT_EXPIRES_IN=7d
# Produzione (RS256): chiave pubblica PEM (\n escaped)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"


# ── OpenAI — Wendy + Growth Agent ────────────────────────────────────────────
# Chiave API OpenAI (obbligatoria per Wendy, onboarding, chat SSE)
OPENAI_API_KEY=sk-proj-...
# Modello da usare (gpt-4o per prod, gpt-4o-mini per dev/test)
OPENAI_MODEL=gpt-4o-mini


# ── Stripe (facoltativo — abbonamenti + commissioni affiliate) ────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# ── Programma Affiliazione ────────────────────────────────────────────────────
# Percentuale commissione (default 20%)
AFFILIATE_COMMISSION_PCT=20
# Importo minimo prelievo in euro (default 10€)
AFFILIATE_MIN_WITHDRAWAL_EUR=10


# ── Server Legacy Express (artifacts/api-server) ─────────────────────────────
# Solo se usi ancora il server legacy (porta 8080)
# ADMIN_KEY=your-admin-key-here
# GNEWS_API_KEY=
# TAVILY_API_KEY=
# RESEND_API_KEY=


# ── AI Microservice Python (artifacts/ai-agents, porta 8000) ─────────────────
# Solo se avvii il microservizio Python AI
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1


# ── Frontend React (apps/web / Vite) ─────────────────────────────────────────
# URL base delle API chiamate dal frontend (deve iniziare con VITE_)
VITE_API_URL=http://localhost:3001/api


# ── Docker secrets (docker-compose.yml) ───────────────────────────────────────
# POSTGRES_PASSWORD — obbligatoria per docker compose up
# REDIS_PASSWORD   — obbligatoria per docker compose up

# ── Distributed Tracing (Jaeger, opzionale) ──────────────────────────────────
# OTEL_SERVICE_NAME=northstar-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
