# =============================================================================
# NorthStar — Variabili d'ambiente richieste
# Copia questo file in .env e compila i valori mancanti.
# In Replit usa i Secrets (tab "Secrets") invece di un file .env.
# =============================================================================

# --- Database (Replit PostgreSQL — creato automaticamente con "Add PostgreSQL") ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- JWT Auth (genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
# OBBLIGATORIO in produzione — senza questo ogni restart disconnette tutti gli utenti
JWT_SECRET=

# --- Admin ---
# Chiave per accedere alle route /admin/* e all'Admin Review Dashboard
# Genera un valore casuale sicuro (es. openssl rand -hex 32)
ADMIN_KEY=

# --- Stripe (opzionale — solo se il checkout è abilitato) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- News (opzionale — necessario per lo scheduler notizie) ---
GNEWS_API_KEY=

# --- Research (opzionale — necessario per lo scheduler ricerca) ---
TAVILY_API_KEY=

# --- Email (opzionale — necessario per reminder e digest settimanale) ---
# Configurazione SMTP (es. Gmail, Resend, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# --- OpenAI (gestito dall'integrazione Replit — non serve inserirlo manualmente) ---
# In Replit con l'integrazione OpenAI attiva, queste variabili sono iniettate automaticamente.
# Su altri ambienti imposta manualmente:
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Runtime ---
PORT=8080
NODE_ENV=development
