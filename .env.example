# =============================================================================
# NorthStar — Variabili d'ambiente richieste
# Copia questo file in .env e compila i valori mancanti.
# In Replit usa i Secrets (tab "Secrets") invece di un file .env.
# =============================================================================

# --- Database (Replit PostgreSQL — creato automaticamente con "Add PostgreSQL") ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# --- JWT Auth (genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
# OBBLIGATORIO in produzione — senza questo ogni restart disconnette tutti gli utenti
JWT_SECRET=

# --- Admin ---
# Chiave per accedere alle route /admin/* e all'Admin Review Dashboard
# Genera un valore casuale sicuro (es. openssl rand -hex 32)
ADMIN_KEY=

# --- Stripe (opzionale — solo se il checkout è abilitato) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google OAuth (opzionale — abilita il pulsante "Accedi con Google") ---
# 1. Vai su https://console.cloud.google.com → "API e servizi" → "Credenziali"
# 2. Crea un "ID client OAuth 2.0" di tipo "Applicazione web"
# 3. Aggiungi agli "URI di reindirizzamento autorizzati": https://tuodominio.com/api/auth/google/callback
# 4. Copia il "Client ID" (non il secret — quello va in GOOGLE_CLIENT_SECRET se usato lato server)
GOOGLE_CLIENT_ID=

# --- News (opzionale — necessario per lo scheduler notizie) ---
# Registrati su https://gnews.io → piano gratuito: 100 richieste/giorno
GNEWS_API_KEY=

# --- Research (opzionale — necessario per lo scheduler ricerca) ---
# Registrati su https://tavily.com → piano gratuito: 1.000 richieste/mese
TAVILY_API_KEY=

# --- Email (opzionale — necessario per reminder e digest settimanale) ---
# Opzione A — Resend (consigliato, usato in produzione da NorthStar):
# Registrati su https://resend.com → aggiungi e verifica il tuo dominio di invio
# (senza dominio verificato, le email funzionano solo verso il tuo indirizzo Resend)
RESEND_API_KEY=re_...
# Opzione B — SMTP generico (Gmail, SendGrid, Mailgun, ecc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# --- Web Push / VAPID (opzionale — notifiche push browser) ---
# Genera le chiavi con: npx web-push generate-vapid-keys
# Incolla il risultato qui sotto (PUBLIC → VAPID_PUBLIC_KEY, PRIVATE → VAPID_PRIVATE_KEY).
# VAPID_EMAIL deve essere un indirizzo raggiungibile (es. il tuo indirizzo di supporto).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=support@example.com

# --- Python AI Service (microservizio LangChain/LangGraph) ---
# URL del servizio Python che gestisce Wiki, Roadmap e Grafo RAG.
# In sviluppo locale punta a localhost:8000 (porta del servizio uvicorn).
# In produzione usa l'URL interno del tuo deployment (es. http://ai-agents:8000).
AI_AGENTS_URL=http://localhost:8000

# --- OpenAI (opzionale — abilita Wiki AI, Roadmap, Growth Research) ---
# Su Replit: attiva l'integrazione "OpenAI" dal pannello Tools → Integrations.
#   Le variabili vengono iniettate automaticamente — non serve impostarle qui.
# Su ambienti non-Replit (Docker, VPS, Railway, Render, ecc.) impostale manualmente:
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Stripe (publishable key — usata dal frontend) ---
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Runtime ---
PORT=8080
NODE_ENV=development
