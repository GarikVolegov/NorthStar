# NorthStar — Variabili d'ambiente
# ─────────────────────────────────────────────────────────────────────────────
# Copia questo file: cp .env.example .env
# Non committare mai il file .env (è in .gitignore)
#
# REGOLA 0: per capire dove vengono usate queste variabili leggi:
#   → API_RULES.md   (server Express, auth, CORS)
#   → DB_RULES.md    (DATABASE_URL, migrations)
#   → AI_RULES.md    (OpenAI, costi, limiti)
#
# Genera JWT_SECRET e ADMIN_KEY con:
#   pnpm secrets        → stampa a video
#   pnpm secrets:env    → aggiunge direttamente a .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Server Express (apps/server) ──────────────────────────────────────────────
# Porta del nuovo server NorthStar
PORT=3001
# Ambiente: development | production
NODE_ENV=development
# Origini permesse dal CORS (virgola-separated, no spazi)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Token Bearer per l'accesso a /api/metrics (opzionale, se non impostato usa solo IP allowlist)
METRICS_TOKEN=
# IP allowlist per l'accesso a /api/metrics (virgola-separated, no spazi, es. 127.0.0.1,192.168.1.0/24)
ALLOWED_IPS=127.0.0.1,::1
# URL base del frontend (usato per costruire referralUrl affiliato)
APP_URL=http://localhost:5173


# ── Database PostgreSQL ───────────────────────────────────────────────────────
# Dev locale (docker compose up postgres)
DATABASE_URL=postgresql://northstar:northstar_dev@localhost:5432/northstar
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECT_TIMEOUT=5000
# Produzione: usa un connection string con SSL
# DATABASE_URL=postgresql://user:password@host:5432/northstar?sslmode=require


# ── JWT ──────────────────────────────────────────────────────────────────────
# Genera un secret con: pnpm secrets  (usa openssl rand -hex 48)
# NON usare un valore predefinito — il docker-compose fallirà se manca.
JWT_SECRET=${JWT_SECRET:?Genera con: pnpm secrets}
# Durata token (es. 7d, 24h, 30m)
JWT_EXPIRES_IN=7d
# Produzione (RS256): chiave pubblica PEM (\n escaped)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"


# ── AI Provider (openai | groq | openrouter) ─────────────────────────────────
# Scegli il backend HTTP per tutte le chat completion. Il model-router
# (packages/ai-server/src/model-router.ts) sceglie poi quale MODELLO usare
# per ogni agente specifico, in base al tier (nano/micro/standard/reasoning).
#
# RACCOMANDATO per costo zero/minimo:
#   AI_PROVIDER=openrouter   → modelli free DeepSeek / Llama / Qwen
#   + AI_INTEGRATIONS_GROQ_API_KEY per routing/classification a costo nullo
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai) — free tier su molti modelli open-source
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Override globale modello (sconsigliato — meglio i MODEL_<TIER> sotto)
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Groq (https://console.groq.com) — free tier generoso, latenza bassissima
# AI_INTEGRATIONS_GROQ_API_KEY=gsk_...

# ── OpenAI — solo per audio/embedding/immagini o premium fallback ───────────
# Necessaria per TTS Wendy, Whisper STT, DALL-E e per il modello premium gpt-4o
# Se non vuoi usare OpenAI per niente, rimuovi e disabilita audio/image features.
OPENAI_API_KEY=sk-proj-...
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Model Router — override per tier (facoltativi) ──────────────────────────
# I default sono già ottimizzati per costo/qualità. Cambia solo se vuoi
# testare un modello diverso senza toccare il codice.
#
# MODEL_NANO_GROQ=llama-3.1-8b-instant
# MODEL_MICRO_GROQ=llama-3.3-70b-versatile
# MODEL_STANDARD_OPENROUTER=deepseek/deepseek-chat-v3-0324:free
# MODEL_STANDARD_GROQ=llama-3.3-70b-versatile
# MODEL_REASONING_OPENROUTER=deepseek/deepseek-r1:free
# MODEL_PREMIUM_OPENAI=gpt-4o
# MODEL_CHEAP_OPENAI=gpt-4o-mini

# Wendy nella barra di ricerca: limite giornaliero utenti Free.
# I piani Pro/Team restano illimitati tramite feature gate wendy_unlimited.
WENDY_FREE_DAILY_LIMIT=40

# OpenHuman personal agent bridge. Disabled by default; keep the core as an
# external local process/app because OpenHuman is GPL-3.0.
OPENHUMAN_ENABLED=false
# Example once the OpenHuman local RPC endpoint is exposed/configured:
# OPENHUMAN_CORE_RPC_URL=http://localhost:43210/rpc
OPENHUMAN_CORE_RPC_URL=
OPENHUMAN_CORE_TOKEN=
OPENHUMAN_TIMEOUT_MS=8000

# Graphify project knowledge graph bridge. Disabled by default; reads local
# graphify-out/graph.json artifacts only and never runs extraction at request time.
GRAPHIFY_ENABLED=false
GRAPHIFY_GRAPHS=root:graphify-out/graph.json,apps:apps/graphify-out/graph.json,packages:packages/graphify-out/graph.json
GRAPHIFY_QUERY_LIMIT=8
GRAPHIFY_MAX_CONTEXT_CHARS=4000
GRAPHIFY_WENDY_ADMIN_ONLY=true

# Wendy Brain globale: memoria di prodotto/skill/stile separata dalla memoria utente.
WENDY_BRAIN_ENABLED=true
WENDY_BRAIN_AUTO_PROMOTE=false
WENDY_BRAIN_MAX_CONTEXT_NODES=6

# Brain runtime vault: indicizza i file `.brain/**/*.md` con `runtime: true` in pgvector.
BRAIN_VAULT_ROOT=.brain
VAULT_INGEST_INTERVAL_MS=86400000
VAULT_INGEST_MAX_FILES=200
VAULT_INGEST_TIMEOUT_MS=300000

# Admin Ops Control Panel: abilita azioni Docker dalla console Admin.
# Default sicuro: false. In dev/VPS puoi abilitarlo se il server vede Docker Compose.
ADMIN_OPS_ENABLED=false
ADMIN_OPS_COMPOSE_FILE=docker-compose.yml
ADMIN_OPS_ALLOWED_SERVICES=northstar-server,postgres,redis
ADMIN_OPS_ALLOW_DB_RESTART=false
ADMIN_OPS_REQUIRE_CONFIRMATION=true
ADMIN_MAINTENANCE_MODE=false


# ── Stripe (abbonamenti + commissioni affiliate) ──────────────────────────────
# Chiave segreta API: richiesta per checkout, cancel e billing portal.
# Senza, il path webhook resta funzionante ma il checkout è disabilitato.
# STRIPE_SECRET_KEY=sk_live_...
# Segreto firma webhook (endpoint POST /api/subscription/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price ID Stripe per ciascun piano/intervallo (necessari per /upgrade).
# Crea i Price in Stripe Dashboard (mode: subscription) e incolla qui gli ID.
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
# STRIPE_TEAM_YEARLY_PRICE_ID=price_...
#
# Importi display in euro mostrati dalla FE (GET /api/subscription/plans).
# Solo per UI: la cifra realmente addebitata è quella del Price su Stripe.
# Default: pro 9/90, team 29/290.
# STRIPE_PRO_MONTHLY_PRICE_EUR=9
# STRIPE_PRO_YEARLY_PRICE_EUR=90
# STRIPE_TEAM_MONTHLY_PRICE_EUR=29
# STRIPE_TEAM_YEARLY_PRICE_EUR=290
#
# Base URL del frontend per success/cancel/return URL di Stripe.
# Se non impostato si usa il primo di ALLOWED_ORIGINS, poi localhost:5173.
# APP_BASE_URL=https://app.northstar.example


# ── Programma Affiliazione ────────────────────────────────────────────────────
# Percentuale commissione (default 20%)
AFFILIATE_COMMISSION_PCT=20
# Riserva wallet: copre prima una mensilita Premium (default 9 euro)
AFFILIATE_RESERVE_CENTS=900
# Importo minimo prelievo. Se non impostato, usa AFFILIATE_RESERVE_CENTS.
# AFFILIATE_MIN_WITHDRAWAL_CENTS=900


# ── Server Legacy Express (artifacts/api-server) ─────────────────────────────
# Solo se usi ancora il server legacy (porta 8080)
# ADMIN_KEY=your-admin-key-here
# GNEWS_API_KEY=
# TAVILY_API_KEY=
# RESEND_API_KEY=


# ── AI Microservice Python (artifacts/ai-agents, porta 8000) ─────────────────
# Solo se avvii il microservizio Python AI
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1


# ── Frontend React (apps/web / Vite) ─────────────────────────────────────────
# URL base delle API chiamate dal frontend (deve iniziare con VITE_)
VITE_API_URL=http://localhost:3001/api


# ── Docker secrets (docker-compose.yml) ───────────────────────────────────────
# POSTGRES_PASSWORD — obbligatoria per docker compose up
# REDIS_PASSWORD   — obbligatoria per docker compose up

# ── Redis Cache ───────────────────────────────────────────────────────────────
# URL di connessione Redis (usata da rate-limit e cache sessioni)
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ── LLM Cost Guard ────────────────────────────────────────────────────────────
# Limiti mensili di costo LLM (USD) per piano
# LLM_COST_LIMIT_FREE=0.50
# LLM_COST_LIMIT_PRO=10.00
# LLM_COST_LIMIT_ENTERPRISE=100.00
# Disabilita il cost guard (solo dev):
# LLM_COST_GUARD_DISABLED=false

# ── Firecrawl self-hosted (opzionale) ────────────────────────────────────────
# Attivare con: docker compose -f docker-compose.yml -f docker-compose.firecrawl.yml up -d
# FIRECRAWL_BASE_URL=http://firecrawl-api:3002          # in docker network
# FIRECRAWL_API_KEY=                                    # opzionale in self-host puro
# FIRECRAWL_TIMEOUT_MS=30000
# FIRECRAWL_NUM_WORKERS=8
# FIRECRAWL_MODEL=gpt-4o-mini                           # LLM usato da /extract
# FIRECRAWL_BLOCK_MEDIA=true                            # blocca img/video in Playwright
# FIRECRAWL_PROXY_SERVER=                               # proxy outbound opzionale
# FIRECRAWL_PROXY_USERNAME=
# FIRECRAWL_PROXY_PASSWORD=
# FIRECRAWL_BULL_AUTH_KEY=                              # auth bull-board opzionale
# FIRECRAWL_LOG_LEVEL=info

# ── Distributed Tracing (Jaeger, opzionale) ──────────────────────────────────
# OTEL_SERVICE_NAME=northstar-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_DISABLED=true

# ── Feature Flags ──────────────────────────────────────────────────────────
# Attiva/disattiva funzionalità senza modificare codice
# FF_PARALLEL_HANDOFF=true   # Parallel handoff tra specialisti
# FF_GENERATIVE_UI=true      # UI tools (render_roadmap, etc.)
# FF_CHAIN_OF_THOUGHT=true   # Hidden CoT reasoning layer
# FF_SUPERVISOR=true         # Quality gate supervisor
# FF_MEMORY=true             # Persistenza memoria

# ── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug            # trace | debug | info | warn | error (default: info in prod, debug in dev)
