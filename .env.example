# =============================================================================
# NorthStar — Variabili d'ambiente
# =============================================================================
# Copia questo file in .env e compila i valori reali.
# NON committare mai il file .env (già in .gitignore).
#
# Regola 0: se aggiungi una variabile qui aggiornala anche in:
#   → API_RULES.md  (se usata nel server)
#   → DB_RULES.md   (se usata nel DB)
# =============================================================================

# ── NODE ───────────────────────────────────────────────────────────
NODE_ENV=development

# ── SERVER ────────────────────────────────────────────────────────
PORT=3001

# Lista origin permessi da CORS (virgola-separati, senza spazi)
# Dev: aggiungi http://localhost:PORT del tuo frontend
# Prod: usa il dominio reale (es. https://northstar.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── DATABASE ────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/northstar

# (Opzionale) URL separato per connessioni read-only (replica)
# DATABASE_URL_READONLY=postgresql://...

# ── AUTH / JWT ──────────────────────────────────────────────────
# Segreto per firmare i JWT (ns_token). Genera con: pnpm secrets
JWT_SECRET=cambia_questo_segreto_prima_di_usarlo

# Durata del token (es. "7d", "30d", "1h")
JWT_EXPIRES_IN=7d

# ── OPENAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Modello usato da Wendy e dagli agent (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# (Opzionale) Organizzazione OpenAI per billing separato
# OPENAI_ORG=org-...

# ── STRIPE ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ID del Price Stripe per il piano mensile NorthStar Premium
# STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_...

# ── AFFILIATE ─────────────────────────────────────────────────
# Commissione affiliati in percentuale (default: 20)
# AFFILIATE_COMMISSION_PCT=20

# Soglia minima per prelievo in euro (default: 10)
# AFFILIATE_MIN_WITHDRAWAL_EUR=10

# ── FRONTEND (usate da Vite con VITE_ prefix) ─────────────────
# URL base dell'API Express visto dal browser
VITE_API_URL=http://localhost:3001/api

# URL pubblico dell'app (usato per costruire referral link, og:url, ecc.)
VITE_APP_URL=http://localhost:3000
