# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Compiled output ────────────────────────────────────────────────────────
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
build/
.next/
out/

# ── Dependencies ───────────────────────────────────────────────────────────
node_modules
.pnpm-store/

# ── Environment & secrets ──────────────────────────────────────────────────
# `.env` is the only versioned env template. Real local values live in `.env.local`.
.env.*
**/.env
!/.env
*.pem
*.key
*.crt
*.p12

# ── Database ───────────────────────────────────────────────────────────────
*.sql
!packages/db/drizzle/*.sql
*.db
*.sqlite
*.sqlite3
backups/

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log
yarn-error.log
testem.log
/libpeerconnection.log

# ── Test output ────────────────────────────────────────────────────────────
test-results/
playwright-report/
coverage/
/typings
graphify-out/
apps/graphify-out/
packages/graphify-out/

# Generated graph nodes/communities are rebuilt on demand, not versioned.
.brain/90_Code/

# ── Temporary & backup files ───────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~

# ── IDE ────────────────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── System files ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
/.sass-cache
/connect.lock

# ── Replit-specific ────────────────────────────────────────────────────────
.cache/
.local/
.vercel/
apps/server/api/index.js
apps/server/api/index.cjs

# Go CLI agentici — sorgenti generati e binari locali
.brain/40_Agent_Context/tools/printed-clis/*/bin/
.brain/40_Agent_Context/tools/printed-clis/*/cmd/
.brain/40_Agent_Context/tools/printed-clis/*/internal/
.brain/40_Agent_Context/tools/printed-clis/*/go.mod
.brain/40_Agent_Context/tools/printed-clis/*/go.sum
.brain/40_Agent_Context/tools/printed-clis/*/.golangci.yml
.brain/40_Agent_Context/tools/printed-clis/*/.goreleaser.yaml
.brain/40_Agent_Context/tools/printed-clis/*/*-pp-*.exe

# Go local installations
go-install/
go123-install/

docs/attached_assets/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Agent browser local state / profiles / session output
.agent-browser/
agent-browser-state*.json
*.agent-browser-state.json
browser-data/
agent-browser.json

# Tool-specific AI folders are local/runtime only.
# Canonical agent context lives in .brain/40_Agent_Context/.
.agents/
.codex/
.codex-dev/
.opencode/
.superpowers/
custom-agents/
custom-workflows/
plugins/northstar-agent-kit/
scripts/ralph/.ralph-prompt.tmp

# Claude may recreate runtime state here; tracked Claude context lives in Brain.
.claude/
