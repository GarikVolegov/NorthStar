{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir":       "./dist",
    "rootDir":      "./src",
    "module":       "commonjs",
    "target":       "ES2022",
    "lib":          ["ES2022"],
    "types":        ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict":       true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
