# apps/web — Variabili d'ambiente frontend
# Copia: cp apps/web/.env.example apps/web/.env.local
# IMPORTANTE: solo le variabili con prefisso VITE_ sono esposte al browser

# URL base delle API (proxy Vite in dev, URL reale in prod)
# Dev:  http://localhost:3001 (proxy configurato in vite.config.ts — non serve /api)
# Prod: https://api.northstar.app
VITE_API_URL=http://localhost:3001
