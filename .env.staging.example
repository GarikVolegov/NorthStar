# ============================================================
# .env.staging.example — NorthStar STAGING
# ============================================================
# ISTRUZIONI:
#   1. Copia questo file in .env.staging
#   2. Sostituisci ogni CHANGEME con il valore reale
#   3. NON committare .env.staging — è in .gitignore
#   4. In GitHub Actions: usa GitHub Environment "staging"
#      e aggiungi i secret dalla UI del repo
# ============================================================
# REGOLA DI SICUREZZA: vedi GIT_RULES.md sezione "Sicurezza"
# ============================================================

# ─── Identificazione ambiente ─────────────────────────────
NODE_ENV=staging
ENVIRONMENT=staging
PORT=8080

# ─── Database staging ─────────────────────────────────────
# Crea un DB separato: northstar_staging (MAI usare prod!)
# Crea due ruoli come da scripts/db-roles.sql
DATABASE_URL=postgresql://northstar_app:CHANGEME@staging-host:5432/northstar_staging
DATABASE_URL_MIGRATOR=postgresql://northstar_migrator:CHANGEME@staging-host:5432/northstar_staging

# ─── Auth ─────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGEME_min_32_chars_hex_string
JWT_EXPIRES_IN=7d
ADMIN_KEY=CHANGEME_min_32_chars_hex_string

# ─── Stripe TEST ──────────────────────────────────────────
# USA SOLO chiavi sk_test_* in staging — MAI sk_live_*
# Webhook separato: crea endpoint staging nella Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME_staging_endpoint
# Stripe Price ID del piano premium (test mode)
STRIPE_PREMIUM_PRICE_ID=price_CHANGEME_test

# ─── AI — MOCK MODE ───────────────────────────────────────
# AI_MOCK_MODE=true → risposte statiche, ZERO costi LLM
# Imposta false solo se vuoi testare l'AI reale in staging
AI_MOCK_MODE=true
OPENAI_API_KEY=sk-proj-CHANGEME_or_leave_if_mock
OPENAI_MODEL=gpt-4o-mini
AI_MODEL=gpt-4o-mini

# Provider override (opzionale, eredita dai default se non impostato)
# AI_STREAMING_PROVIDER=groq
# AI_AGENT_PROVIDER=anthropic
# AI_EMBEDDING_PROVIDER=openai

# ─── Email (Resend) ───────────────────────────────────────
# Usa un dominio di test o abilita sandbox mode in Resend
RESEND_API_KEY=re_CHANGEME_test
EMAIL_FROM=noreply@staging.northstar.dev

# ─── CORS & Origins ───────────────────────────────────────
# URL pubblico del frontend staging
CORS_ORIGIN=https://northstar-staging.up.railway.app
ALLOWED_ORIGINS=https://northstar-staging.up.railway.app
VITE_API_URL=https://northstar-staging-api.up.railway.app/api
VITE_APP_URL=https://northstar-staging.up.railway.app

# ─── AI Agents (FastAPI Python) ───────────────────────────
# URL del microservizio Python in staging
AI_AGENTS_URL=http://ai-agents-staging:8000
# Se AI_MOCK_MODE=true questo URL non viene usato

# ─── Monitoring ───────────────────────────────────────────
# Ottieni DSN gratis su https://sentry.io — progetto separato "northstar-staging"
SENTRY_DSN=https://CHANGEME@oXXXXXX.ingest.sentry.io/XXXXXXX
# 10% sampling in staging (riduce quota)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Notifiche Push (VAPID) ───────────────────────────────
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGEME
VAPID_PRIVATE_KEY=CHANGEME
VAPID_SUBJECT=mailto:admin@northstar.dev

# ─── News / Ricerca ───────────────────────────────────────
GNEWS_API_KEY=CHANGEME
TAVILY_API_KEY=CHANGEME

# ─── Affiliate ────────────────────────────────────────────
AFFILIATE_COMMISSION_PCT=20
AFFILIATE_MIN_WITHDRAWAL_EUR=10
# Soglia holdback in centesimi (2900 = 29€)
AFFILIATE_HOLDBACK_CENTS=2900

# ─── Google OAuth (opzionale in staging) ──────────────────
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
