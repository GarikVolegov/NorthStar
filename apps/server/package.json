{
  "name": "@northstar/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@northstar/ml-client": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.57.1",
    "@opentelemetry/instrumentation-http": "^0.57.2",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@sentry/node": "^10.29.0",
    "@workspace/ai-server": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/ws-server": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "catalog:",
    "openai": "catalog:",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.27.3",
    "supertest": "^7.1.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.1.2"
  }
}
