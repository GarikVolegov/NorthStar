{
  "name": "@northstar/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev":   "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint":  "eslint src --ext .ts",
    "test":  "vitest run",
    "test:watch": "vitest",

    "// ── SEED E2E ──────────────────────────────────────────────────────────": "---",
    "seed:e2e":           "tsx ../../scripts/src/seed-e2e.ts",
    "seed:e2e-affiliate": "tsx ../../scripts/src/seed-e2e-affiliate.ts"
  },
  "dependencies": {
    "@workspace/db":    "*",
    "bcryptjs":         "^2.4.3",
    "cookie-parser":    "^1.4.7",
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.7",
    "express":          "^4.19.2",
    "helmet":           "^7.1.0",
    "ioredis":          "^5.4.1",
    "jsonwebtoken":     "^9.0.2",
    "openai":           "^4.52.0",
    "pino":             "^9.3.2",
    "stripe":           "^16.2.0",
    "zod":              "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs":      "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors":          "^2.8.17",
    "@types/express":       "^4.17.21",
    "@types/jsonwebtoken":  "^9.0.7",
    "@types/node":          "^20.14.0",
    "@types/supertest":     "^6.0.2",
    "pino-pretty":          "^11.2.1",
    "supertest":            "^7.0.0",
    "tsx":                  "^4.16.0",
    "typescript":           "^5.5.0",
    "vitest":               "^1.6.0"
  }
}
