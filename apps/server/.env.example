# ── NorthStar Server — Environment Variables ──────────────────────────────────
# Copia questo file in .env e compila i valori mancanti.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/northstar

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-questo-con-almeno-32-caratteri-random
ADMIN_BREAK_GLASS_KEY=chiave-break-glass-solo-server

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxx
RESEND_FROM_EMAIL=NorthStar <noreply@northstar.app>
APP_URL=https://northstar.app

# ── AI Provider ───────────────────────────────────────────────────────────────
#
# OPZIONE GRATUITA CONSIGLIATA: OpenRouter (registrazione su openrouter.ai)
# Tutti i tier usano modelli free: deepseek-chat-v3, deepseek-r1, llama-3.3
#
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Modelli free espliciti per tier (già impostati di default, override opzionale)
# MODEL_NANO_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
# MODEL_MICRO_OPENROUTER=deepseek/deepseek-chat-v3-0324:free
# MODEL_STANDARD_OPENROUTER=deepseek/deepseek-chat-v3-0324:free
# MODEL_REASONING_OPENROUTER=deepseek/deepseek-r1:free

#
# ALTERNATIVA GRATUITA: Groq (registrazione su console.groq.com)
# Velocissimo (14k tok/s per llama-3.1-8b), free tier generoso
#
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Disabilita mock mode per usare le API reali
AI_MOCK_MODE=false

# Wendy nella barra di ricerca: limite giornaliero utenti Free.
# I piani Pro/Team restano illimitati tramite feature gate wendy_unlimited.
WENDY_FREE_DAILY_LIMIT=40

# OpenHuman personal agent bridge. Disabled by default; the OpenHuman desktop/core
# app remains a separate GPL-3.0 process and NorthStar talks to it over local RPC.
OPENHUMAN_ENABLED=false
# OPENHUMAN_CORE_RPC_URL=http://localhost:43210/rpc
OPENHUMAN_CORE_RPC_URL=
OPENHUMAN_CORE_TOKEN=
OPENHUMAN_TIMEOUT_MS=8000

# Graphify project knowledge graph bridge. Disabled by default; reads local
# graphify-out/graph.json artifacts only and never runs extraction at request time.
GRAPHIFY_ENABLED=false
GRAPHIFY_GRAPHS=root:graphify-out/graph.json,apps:apps/graphify-out/graph.json,packages:packages/graphify-out/graph.json
GRAPHIFY_QUERY_LIMIT=8
GRAPHIFY_MAX_CONTEXT_CHARS=4000
GRAPHIFY_WENDY_ADMIN_ONLY=true

# Wendy Brain globale: memoria di prodotto/skill/stile separata dalla memoria utente.
WENDY_BRAIN_ENABLED=true
WENDY_BRAIN_AUTO_PROMOTE=false
WENDY_BRAIN_MAX_CONTEXT_NODES=6

# Admin Ops Control Panel: abilita azioni Docker dalla console Admin.
# Default sicuro: false. In dev/VPS puoi abilitarlo se il server vede Docker Compose.
ADMIN_OPS_ENABLED=false
ADMIN_OPS_COMPOSE_FILE=docker-compose.yml
ADMIN_OPS_ALLOWED_SERVICES=northstar-server,postgres,redis
ADMIN_OPS_ALLOW_DB_RESTART=false
ADMIN_OPS_REQUIRE_CONFIRMATION=true
ADMIN_MAINTENANCE_MODE=false

# ── Redis (opzionale, per caching) ───────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Stripe (opzionale, per abbonamenti premium) ───────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
AFFILIATE_COMMISSION_PCT=20
AFFILIATE_RESERVE_CENTS=900
# AFFILIATE_MIN_WITHDRAWAL_CENTS=900

# ── Google OAuth (opzionale) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── News API (opzionale, per collector) ───────────────────────────────────────
# NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Monitoring & Alerts ───────────────────────────────────────────────────────
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
