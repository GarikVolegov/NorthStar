# NorthStar Server — variabili d'ambiente
# Copia questo file in .env e compila i valori

# ── Server ────────────────────────────────────────────────
# Porta del server Express (default 3001)
PORT=3001
# Ambiente: development | production
NODE_ENV=development
# Origini permesse dal CORS (virgola-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/northstar

# ── JWT ─────────────────────────────────────────────────
# Sviluppo: secret HS256
JWT_SECRET=northstar-dev-secret-change-me-in-production
# Produzione: chiave pubblica RS256 (PEM, \n escape)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"

# ── OpenAI ──────────────────────────────────────────────
# Chiave API OpenAI per Wendy (growth agent + onboarding)
OPENAI_API_KEY=sk-...

# ── Stripe (facoltativo — per webhook commissioni affiliate) ─────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── App URL ──────────────────────────────────────────────
# URL base del frontend (per costruire referralUrl nei link affiliato)
APP_URL=https://northstar.app
