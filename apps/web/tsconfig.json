{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":           "ES2020",
    "lib":              ["ES2020", "DOM", "DOM.Iterable"],
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "react-jsx",
    "strict":           true,
    "noEmit":           true,
    "composite":        false,
    "baseUrl":          ".",
    "paths": {
      "@/*":             ["./src/*"],
      "@growth-agent":   ["../../lib/growth-agent/src/index"],
      "@growth-agent/*": ["../../lib/growth-agent/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
